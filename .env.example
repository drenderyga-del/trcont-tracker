# Telegram
TELEGRAM_BOT_TOKEN=123456:your_bot_token
# Один chat_id или несколько через запятую: 123456789,-1001234567890
TELEGRAM_CHAT_ID=123456789

# Номера контейнеров/оборудования через запятую.
EQUIPMENT_NUMBERS=TKRU4553164

# Основной цикл
POLL_INTERVAL_SECONDS=3600
PER_EQUIPMENT_DELAY_SECONDS=3
STATE_DIR=state

# Уведомления о здоровье сервиса
# 0 = отключить heartbeat.
HEARTBEAT_INTERVAL_SECONDS=86400
# 0 = отключить алерт о полностью провальных циклах.
ALERT_AFTER_FULL_FAIL_CYCLES=3
SEND_STARTUP_MESSAGE=false

# Расчет скорости и отладочные данные
SPEED_WINDOW_HOURS=6
SAVE_RAW_DISLOCATION=true

# Playwright / SmartCaptcha. Обычно менять не нужно.
HEADLESS=true
NAV_TIMEOUT_MS=60000
SEARCH_TIMEOUT_MS=60000
FETCH_ATTEMPTS=4
CAPTCHA_RETRY_DELAY_S=1.5
CAPTCHA_BACKOFF_S=300
PRE_CLICK_DELAY_MS=500
